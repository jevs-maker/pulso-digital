---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="section" style="padding: 80px 0 120px; max-width: 60ch;">
    <span class="kicker">Error 404</span>
    <h1 style="font-size: clamp(2.2rem, 4vw, 3rem); margin-top: 12px;">Esta página no existe.</h1>
    <p class="muted" style="margin-top: 14px;">
      Puede que el enlace haya cambiado o que la historia se haya movido de sección.
    </p>
    <a class="btn btn-primary" style="margin-top: 24px;" href="/">Volver a la portada</a>
  </section>
</Base>
