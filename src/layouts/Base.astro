---
import '../styles/global.css';
import { sitio, secciones } from '../data/sitio';

interface Props {
  titulo?: string;
  descripcion?: string;
  jsonLd?: Record<string, unknown>;
}

const { titulo, descripcion = sitio.descripcion, jsonLd } = Astro.props;
const pageTitle = titulo
  ? `${titulo} · ${sitio.nombre}`
  : `${sitio.nombre} — Tecnología, IA y dinero digital sin humo`;
const canonical = new URL(Astro.url.pathname, sitio.url).href;
const actual = Astro.url.pathname;
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#eef4f9" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='9' fill='%233a6f94'/%3E%3C/svg%3E" />
    <script is:inline>
      (function () {
        try {
          var guardado = localStorage.getItem('pulso-tema');
          var sistema = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = guardado || (sistema ? 'dark' : 'light');
        } catch (e) {}
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <div class="nav">
          <a class="brand" href="/">
            <span class="brand-dot"></span>
            {sitio.nombre}
          </a>
          <nav class="nav-links" aria-label="Secciones">
            {secciones.map((s) => (
              <a href={`/categoria/${s.slug}/`} aria-current={actual === `/categoria/${s.slug}/` ? 'page' : undefined}>
                {s.nombre}
              </a>
            ))}
          </nav>
          <div class="nav-actions">
            <button class="theme-btn" type="button" data-tema aria-pressed="false" aria-label="Cambiar a modo noche">
              <svg class="icono-luna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
              <svg class="icono-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
              <span data-tema-texto>Noche</span>
            </button>
            <a class="btn btn-primary btn-sm" href="#newsletter">Suscribirme</a>
          </div>
        </div>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <div class="wrap">
      <footer class="site-foot">
        <div>
          <strong style="color: var(--text); font-size: 1rem;">{sitio.nombre}</strong>
          <p class="small" style="margin-top: 4px;">{sitio.descripcion}</p>
        </div>
        <nav class="small" aria-label="Legal" style="display: flex; gap: 18px; flex-wrap: wrap;">
          <a href="/sobre-nosotros/">Sobre nosotros</a>
          <a href="/privacidad/">Privacidad</a>
          <a href="/cookies/">Cookies</a>
          <a href="/contacto/">Contacto</a>
        </nav>
        <p class="tiny">© {new Date().getFullYear()} {sitio.nombre}</p>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var boton = document.querySelector('[data-tema]');
        if (!boton) return;
        var texto = boton.querySelector('[data-tema-texto]');
        function pintar() {
          var oscuro = document.documentElement.dataset.theme === 'dark';
          boton.setAttribute('aria-pressed', oscuro ? 'true' : 'false');
          boton.setAttribute('aria-label', oscuro ? 'Cambiar a modo día' : 'Cambiar a modo noche');
          if (texto) texto.textContent = oscuro ? 'Día' : 'Noche';
        }
        pintar();
        boton.addEventListener('click', function () {
          var siguiente = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = siguiente;
          try { localStorage.setItem('pulso-tema', siguiente); } catch (e) {}
          pintar();
        });
      })();
    </script>
  </body>
</html>
